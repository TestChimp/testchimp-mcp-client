{
  "name": "@testchimp/cli",
  "version": "0.1.51",
  "description": "TestChimp CLI and MCP server — coverage, plans, EaaS, TrueCoverage, API operations (calls /api/mcp/*)",
  "type": "module",
  "main": "dist/bin/testchimp.js",
  "types": "dist/bin/testchimp.d.ts",
  "bin": {
    "testchimp": "dist/bin/testchimp.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/bin/testchimp.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.2"
  },
  "keywords": [
    "testchimp",
    "mcp",
    "cli",
    "model-context-protocol"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
